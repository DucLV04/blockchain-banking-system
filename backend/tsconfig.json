{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "hardhat.config.ts",
    "scripts/**/*.ts",
    "deploy/**/*.ts",
    "test/**/*.ts",
    "typechain/**/*.ts"
  ],
  "files": ["hardhat.config.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "typechain"
  ]
}
